{{! Modified by EXODIA: customer-facing branding. }}
<header>
  <table
    width="560"
    cellspacing="0"
    cellpadding="0"
    border="0"
    class="mobile-width"
    align="center"
    valign="top"
    style="
      border-collapse: collapse;
      width: 560px;
      max-width: 560px;
      background-color: #ffffff;
    "
  >
    <tr>
      <td
        style="
          padding: 40px 30px 0 30px;
          font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        "
      >
        {{#if orgName}}
          <div
            style="
              font-size: 24px;
              font-weight: 700;
              color: #1d1c1d;
              letter-spacing: -0.25px;
              line-height: 28px;
            "
          >
            {{orgName}}
          </div>
          <div
            style="
              font-size: 12px;
              font-weight: 400;
              color: #5e5e5e;
              line-height: 20px;
              margin-top: 4px;
            "
          >
            <img src="https://brain.exodia.ws/logo/exodia-brain-mark.png" alt="" width="24" height="24" style="vertical-align:middle;margin-right:6px;" /> Powered by EXODIA Brain
          </div>
        {{else}}
          <div
            style="
              font-size: 24px;
              font-weight: 700;
              color: #1d1c1d;
              letter-spacing: -0.25px;
              line-height: 28px;
            "
          >
            <img src="https://brain.exodia.ws/logo/exodia-brain-logo.png" alt="EXODIA Brain" width="210" style="display:block;max-width:100%;height:auto;" />
          </div>
        {{/if}}
      </td>
    </tr>
  </table>
</header>
